# AIDEX'26 ESCAPE ROOM - Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file

PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Get this from: MongoDB Atlas > Your Cluster > Connect > Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/escaperoom?retryWrites=true&w=majority

# Admin Panel Passkey
ADMIN_PASSKEY=your_admin_passkey_here
ADMIN_SECRET=your_admin_secret_here
